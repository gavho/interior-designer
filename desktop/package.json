{
  "name": "interior-designer-desktop",
  "productName": "Interior Designer",
  "version": "0.2.0",
  "description": "Desktop app for Interior Designer: native file saving, offline 3D engine, full-resolution renders",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "three": "0.170.0",
    "three-mesh-bvh": "0.7.8",
    "three-gpu-pathtracer": "0.0.23"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.interiordesigner.desktop",
    "productName": "Interior Designer",
    "files": ["main.cjs", "preload.cjs", "node_modules/three/**", "node_modules/three-mesh-bvh/**", "node_modules/three-gpu-pathtracer/**"],
    "extraResources": [{ "from": "..", "to": "web", "filter": ["index.html", "styles.css", "manifest.webmanifest", "src/**", "samples/**", "icons/**", "hud/dist/**"] }],
    "fileAssociations": [{ "ext": "json", "name": "Interior Designer project", "role": "Editor" }],
    "mac": { "category": "public.app-category.graphics-design", "icon": "../icons/icon-512.png" },
    "win": { "icon": "../icons/icon-512.png" },
    "linux": { "category": "Graphics", "icon": "../icons/icon-512.png" }
  }
}
